# ------------------------------
# Frontend (Vite)
# ------------------------------
# Public backend API URL — used only in **production** builds (vite build).
# Leave unset for local `npm run dev`: the app calls `/api` and Vite proxies to PORT below.
# (A system-wide VITE_API_URL pointing at the wrong port breaks login in dev.)
VITE_API_URL=https://your-api.onrender.com

# ------------------------------
# Backend (Render Web Service)
# ------------------------------
PORT=3001
# Local: start API + Vite together (Vite proxies /api to PORT): npm run dev:all
# With API already running, check GET /api/users exists: npm run test:api-users
JWT_SECRET=change-this-to-a-long-random-secret

# CORS allowlist (comma-separated for multiple domains)
CORS_ORIGIN=https://your-frontend.onrender.com
# FRONTEND_URL can be used as fallback if CORS_ORIGIN is not set.
FRONTEND_URL=https://your-frontend.onrender.com

# ------------------------------
# Database (External - recommended for Render)
# ------------------------------
# Use MongoDB Atlas (recommended).
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=inventory_system
MONGODB_COLLECTION=app_state

# If false, local file persistence is disabled (recommended in production).
USE_LOCAL_DATA_FILE=false

# ------------------------------
# Cloudinary (persistent file storage)
# ------------------------------
# Render's disk is ephemeral — anything saved to the local /uploads folder is wiped on every
# redeploy. Set these so uploaded files (invoices, warranty docs, photos, etc.) are stored on
# Cloudinary instead and survive redeploys. Get these from https://console.cloudinary.com → Dashboard.
# If left unset, the app automatically falls back to local /uploads storage (fine for local dev).
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Optional: instead of the 3 vars above, you can set the single combined URL Cloudinary shows
# on the dashboard (cloudinary://API_KEY:API_SECRET@CLOUD_NAME). If set, it takes priority.
# CLOUDINARY_URL=cloudinary://your-api-key:your-api-secret@your-cloud-name
# Optional: base folder name under which files are organized in your Cloudinary account.
CLOUDINARY_UPLOAD_FOLDER=crane-system
#
# IMPORTANT (new Cloudinary accounts): PDF and ZIP delivery is blocked by default for security.
# Since this system stores invoices/warranty/inspection PDFs, enable delivery in the Cloudinary
# Console: Settings → Security → check "Allow delivery of PDF and ZIP files".

# ------------------------------
# SMTP / Alert emails
# ------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-mailbox@example.com
SMTP_PASS=your-password-or-app-password
SMTP_FROM=your-mailbox@example.com

ALERT_MAIL_TO_MANAGER=manager@example.com
ALERT_MAIL_TO_PROCUREMENT=procurement@example.com

# Stock alert digest email: one automatic send per calendar day (server local time) when alerts exist.
#
# If this variable is SET (true or false), it ALWAYS wins over the value saved in MongoDB / data.json.
# Use STOCK_ALERT_MAIL_ENABLED=false on Render to force-stop mails even if the DB still has "on".
# If you omit this variable entirely, the saved app setting from the Alerts UI / DB is used.
STOCK_ALERT_MAIL_ENABLED=false
# Use 24h clock, e.g. 08:00 or 14:30
STOCK_ALERT_MAIL_DAILY_AT=08:00
